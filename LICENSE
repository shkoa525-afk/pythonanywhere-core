import tkinter as tk
from tkinter import ttk, messagebox, filedialog, scrolledtext
import json
import os
import shutil
import hashlib
import datetime
import sqlite3
from PIL import Image, ImageTk
import base64
import getpass
import subprocess

# ============ سیستەمی داخڵبوون ============
class LoginSystem:
    def __init__(self):
        self.users_file = "users.json"
        self.load_users()
    
    def load_users(self):
        if os.path.exists(self.users_file):
            with open(self.users_file, 'r') as f:
                self.users = json.load(f)
        else:
            # یوزەری ئەدمینی سەرەتایی
            self.users = {
                "admin": {
                    "password": self.hash_password("admin123"),
                    "role": "admin",
                    "created": str(datetime.datetime.now()),
                    "permissions": ["all"]
                }
            }
            self.save_users()
    
    def save_users(self):
        with open(self.users_file, 'w') as f:
            json.dump(self.users, f, indent=4)
    
    def hash_password(self, password):
        return hashlib.sha256(password.encode()).hexdigest()
    
    def register(self, username, password, role="user"):
        if username in self.users:
            return False, "یوزەر هەیە!"
        
        self.users[username] = {
            "password": self.hash_password(password),
            "role": role,
            "created": str(datetime.datetime.now()),
            "permissions": ["read"]
        }
        self.save_users()
        return True, "بە سەرکەوتوویی تۆمارکرا!"
    
    def login(self, username, password):
        if username not in self.users:
            return False, "یوزەر نییە!", None
        
        user = self.users[username]
        if user["password"] == self.hash_password(password):
            return True, "بە سەرکەوتوویی داخڵبووی!", user
        return False, "پاسۆرد هەڵەیە!", None

# ============ سیستەمی فایل ============
class FileManager:
    def __init__(self):
        self.base_dir = "app_storage"
        self.admin_dir = "admin_data"
        self.create_directories()
    
    def create_directories(self):
        os.makedirs(self.base_dir, exist_ok=True)
        os.makedirs(self.admin_dir, exist_ok=True)
        os.makedirs(os.path.join(self.base_dir, "users"), exist_ok=True)
        os.makedirs(os.path.join(self.base_dir, "public"), exist_ok=True)
        os.makedirs(os.path.join(self.base_dir, "private"), exist_ok=True)
    
    def list_files(self, path="."):
        try:
            items = os.listdir(path)
            files = []
            folders = []
            
            for item in items:
                item_path = os.path.join(path, item)
                if os.path.isdir(item_path):
                    folders.append((item, "📁", item_path, "فۆڵدەر"))
                else:
                    size = os.path.getsize(item_path)
                    files.append((item, "📄", item_path, f"{size:,} بایت"))
            
            return folders + files
        except Exception as e:
            return []
    
    def create_folder(self, path, name):
        try:
            full_path = os.path.join(path, name)
            os.makedirs(full_path, exist_ok=True)
            return True, "فۆڵدەر دروستکرا!"
        except Exception as e:
            return False, str(e)
    
    def delete_item(self, path):
        try:
            if os.path.isdir(path):
                shutil.rmtree(path)
                return True, "فۆڵدەر سڕدرایەوە!"
            else:
                os.remove(path)
                return True, "فایل سڕدرایەوە!"
        except Exception as e:
            return False, str(e)
    
    def upload_file(self, dest_path, file_path):
        try:
            shutil.copy2(file_path, dest_path)
            return True, "فایل بارکرا!"
        except Exception as e:
            return False, str(e)

# ============ ڕوکاری سەرەکی ============
class ModernApp:
    def __init__(self):
        self.login_system = LoginSystem()
        self.file_manager = FileManager()
        self.current_user = None
        
        self.root = tk.Tk()
        self.root.title("ئەپی پێشکەوتوو - پانێڵی بەڕێوەبردنی تەواو")
        self.root.geometry("1200x700")
        
        # ستایلی زیندوو
        self.setup_styles()
        self.show_login_screen()
        
    def setup_styles(self):
        style = ttk.Style()
        
        # ڕەنگە سەرەکیەکان
        self.colors = {
            "primary": "#2E86AB",
            "secondary": "#A23B72",
            "success": "#18A999",
            "warning": "#F18F01",
            "danger": "#C73E1D",
            "dark": "#2D3142",
            "light": "#F5F5F5"
        }
        
        # ستایلی تەختەکان
        style.configure("Primary.TFrame", background=self.colors["primary"])
        style.configure("Dark.TFrame", background=self.colors["dark"])
        style.configure("Light.TFrame", background=self.colors["light"])
        
        # ستایلی دوگمەکان
        style.configure("Primary.TButton", 
                       font=("Arial", 10, "bold"),
                       padding=10,
                       background=self.colors["primary"],
                       foreground="white")
        
        style.configure("Success.TButton",
                       font=("Arial", 10, "bold"),
                       padding=10,
                       background=self.colors["success"],
                       foreground="white")
    
    def show_login_screen(self):
        self.clear_window()
        
        # قابڵەکی سەرەکی
        main_frame = ttk.Frame(self.root, style="Primary.TFrame")
        main_frame.pack(fill="both", expand=True)
        
        # قابڵەی ناوەندی
        center_frame = ttk.Frame(main_frame, style="Light.TFrame")
        center_frame.place(relx=0.5, rely=0.5, anchor="center", width=400, height=500)
        
        # تایتڵ
        title_label = tk.Label(center_frame, 
                              text="👑 ئەپی پێشکەوتوو 👑",
                              font=("Arial", 20, "bold"),
                              fg=self.colors["primary"],
                              bg=self.colors["light"])
        title_label.pack(pady=30)
        
        # یوزەرنەیم
        tk.Label(center_frame, text="یوزەرنەیم:", 
                font=("Arial", 12),
                bg=self.colors["light"]).pack(pady=5)
        self.username_entry = ttk.Entry(center_frame, font=("Arial", 12))
        self.username_entry.pack(pady=5, padx=20, fill="x")
        
        # پاسۆرد
        tk.Label(center_frame, text="پاسۆرد:", 
                font=("Arial", 12),
                bg=self.colors["light"]).pack(pady=5)
        self.password_entry = ttk.Entry(center_frame, font=("Arial", 12), show="•")
        self.password_entry.pack(pady=5, padx=20, fill="x")
        
        # دوگمەی داخڵبوون
        login_btn = ttk.Button(center_frame, 
                              text="داخل ببە 🚀", 
                              style="Primary.TButton",
                              command=self.handle_login)
        login_btn.pack(pady=20, ipadx=20)
        
        # دوگمەی تۆمارکردن
        register_btn = ttk.Button(center_frame,
                                 text="تۆمارکردنی نوێ",
                                 style="Success.TButton",
                                 command=self.show_register_popup)
        register_btn.pack(pady=10)
        
        # وەشان
        version_label = tk.Label(center_frame,
                                text="وەشان ١.٠.٠ - © ٢٠٢٤",
                                font=("Arial", 9),
                                fg="gray",
                                bg=self.colors["light"])
        version_label.pack(side="bottom", pady=10)
    
    def handle_login(self):
        username = self.username_entry.get()
        password = self.password_entry.get()
        
        if not username or not password:
            messagebox.showwarning("هەڵە", "تکایە هەموو خانەکان پڕبکەرەوە!")
            return
        
        success, message, user = self.login_system.login(username, password)
        
        if success:
            self.current_user = user
            self.current_username = username
            messagebox.showinfo("سەرکەوتوو", message)
            if user["role"] == "admin":
                self.show_admin_panel()
            else:
                self.show_user_panel()
        else:
            messagebox.showerror("هەڵە", message)
    
    def show_register_popup(self):
        popup = tk.Toplevel(self.root)
        popup.title("تۆمارکردنی نوێ")
        popup.geometry("400x400")
        popup.configure(bg=self.colors["light"])
        
        tk.Label(popup, text="تۆمارکردنی یوزەری نوێ",
                font=("Arial", 16, "bold"),
                bg=self.colors["light"],
                fg=self.colors["primary"]).pack(pady=20)
        
        tk.Label(popup, text="یوزەرنەیم:", bg=self.colors["light"]).pack(pady=5)
        reg_user = ttk.Entry(popup, font=("Arial", 12))
        reg_user.pack(pady=5, padx=20, fill="x")
        
        tk.Label(popup, text="پاسۆرد:", bg=self.colors["light"]).pack(pady=5)
        reg_pass = ttk.Entry(popup, font=("Arial", 12), show="•")
        reg_pass.pack(pady=5, padx=20, fill="x")
        
        tk.Label(popup, text="دووبارەکردنەوەی پاسۆرد:", bg=self.colors["light"]).pack(pady=5)
        reg_pass2 = ttk.Entry(popup, font=("Arial", 12), show="•")
        reg_pass2.pack(pady=5, padx=20, fill="x")
        
        def register():
            if reg_pass.get() != reg_pass2.get():
                messagebox.showerror("هەڵە", "پاسۆردەکان یەکسان نین!")
                return
            
            success, msg = self.login_system.register(reg_user.get(), reg_pass.get())
            if success:
                messagebox.showinfo("سەرکەوتوو", msg)
                popup.destroy()
            else:
                messagebox.showerror("هەڵە", msg)
        
        ttk.Button(popup, text="تۆمارکردن", command=register).pack(pady=20)
    
    # ============ پانێڵی ئەدمین ============
    def show_admin_panel(self):
        self.clear_window()
        
        # قابڵەی سەرەکی
        main_container = ttk.Frame(self.root)
        main_container.pack(fill="both", expand=True)
        
        # سایدباری چەپ
        sidebar = ttk.Frame(main_container, style="Dark.TFrame", width=250)
        sidebar.pack(side="left", fill="y")
        sidebar.pack_propagate(False)
        
        # تایتڵی سایدبار
        tk.Label(sidebar, 
                text="👑 پانێڵی ئەدمین 👑",
                font=("Arial", 14, "bold"),
                fg="white",
                bg=self.colors["dark"]).pack(pady=20)
        
        # لیستی بەڕێوەبەرەکان
        menu_items = [
            ("📊 داشبۆرد", self.show_dashboard),
            ("📁 بەڕێوەبردنی فایل", self.show_file_manager),
            ("👥 بەڕێوەبردنی یوزەر", self.show_user_manager),
            ("⚙️ ڕێکخستنەکان", self.show_settings),
            ("📈 راپۆرتەکان", self.show_reports),
            ("🔒 سیستەمی دەسەلات", self.show_permissions),
            ("🛠️ ئامرازە پێشکەوتووەکان", self.show_advanced_tools),
            ("🚪 چوونەدەرەوە", self.logout)
        ]
        
        for text, command in menu_items:
            btn = tk.Button(sidebar,
                          text=text,
                          font=("Arial", 11),
                          bg=self.colors["dark"],
                          fg="white",
                          activebackground=self.colors["primary"],
                          activeforeground="white",
                          bd=0,
                          padx=20,
                          pady=15,
                          anchor="w",
                          command=command,
                          cursor="hand2")
            btn.pack(fill="x", padx=10, pady=2)
            btn.bind("<Enter>", lambda e, b=btn: b.config(bg=self.colors["primary"]))
            btn.bind("<Leave>", lambda e, b=btn: b.config(bg=self.colors["dark"]))
        
        # نیشاندانی یوزەر
        user_frame = ttk.Frame(sidebar, style="Dark.TFrame")
        user_frame.pack(side="bottom", fill="x", pady=20)
        
        tk.Label(user_frame,
                text=f"بەخێربێت: {self.current_username}",
                font=("Arial", 10, "italic"),
                fg="lightgreen",
                bg=self.colors["dark"]).pack()
        
        tk.Label(user_frame,
                text="ڕۆڵ: ئەدمین",
                font=("Arial", 9),
                fg="yellow",
                bg=self.colors["dark"]).pack()
        
        # قابڵەی ناوەند
        self.content_area = ttk.Frame(main_container, style="Light.TFrame")
        self.content_area.pack(side="right", fill="both", expand=True)
        
        # نیشاندانی داشبۆرد
        self.show_dashboard()
    
    def show_dashboard(self):
        self.clear_content_area()
        
        # تایتڵ
        title = tk.Label(self.content_area,
                        text="📊 دەشبۆردی ئەدمین",
                        font=("Arial", 20, "bold"),
                        fg=self.colors["dark"],
                        bg=self.colors["light"])
        title.pack(pady=20)
        
        # کارتەکان
        cards_frame = ttk.Frame(self.content_area)
        cards_frame.pack(pady=20, padx=20, fill="x")
        
        cards = [
            ("یوزەرەکان", len(self.login_system.users), "👥", self.colors["primary"]),
            ("فۆڵدەرەکان", self.count_folders(), "📁", self.colors["success"]),
            ("فایلەکان", self.count_files(), "📄", self.colors["warning"]),
            ("دەسەلاتەکان", "بێ سنوور", "🔒", self.colors["danger"])
        ]
        
        for i, (text, value, icon, color) in enumerate(cards):
            card = tk.Frame(cards_frame, bg=color, relief="raised", bd=2)
            card.grid(row=0, column=i, padx=10, ipadx=20, ipady=30)
            
            tk.Label(card, text=icon, font=("Arial", 24), bg=color, fg="white").pack()
            tk.Label(card, text=str(value), font=("Arial", 18, "bold"), bg=color, fg="white").pack()
            tk.Label(card, text=text, font=("Arial", 12), bg=color, fg="white").pack()
        
        # چالاکیە نوێیەکان
        activity_frame = ttk.LabelFrame(self.content_area, text="چالاکیە نوێیەکان")
        activity_frame.pack(pady=20, padx=20, fill="both", expand=True)
        
        activity_text = scrolledtext.ScrolledText(activity_frame, height=10)
        activity_text.pack(fill="both", expand=True, padx=10, pady=10)
        
        activities = [
            f"{datetime.datetime.now().strftime('%H:%M')} - یوزەری ئەدمین داخڵبوو",
            f"{datetime.datetime.now().strftime('%H:%M')} - پانێڵی بەڕێوەبردنی دەستکاریکرا",
            f"{datetime.datetime.now().strftime('%H:%M')} - هەموو سیستەمەکان چالاکن"
        ]
        
        for activity in activities:
            activity_text.insert("end", activity + "\n")
    
    def show_file_manager(self):
        self.clear_content_area()
        
        # تایتڵ
        tk.Label(self.content_area,
                text="📁 بەڕێوەبردنی فایلەکان",
                font=("Arial", 20, "bold"),
                fg=self.colors["dark"],
                bg=self.colors["light"]).pack(pady=20)
        
        # بارتۆڵی ئامرازەکان
        toolbar = ttk.Frame(self.content_area)
        toolbar.pack(pady=10, padx=20, fill="x")
        
        buttons = [
            ("📁 فۆڵدەری نوێ", self.create_new_folder),
            ("📤 بارکردنی فایل", self.upload_file),
            ("🗑️ سڕینەوە", self.delete_selected),
            ("📥 دابەزاندن", self.download_file),
            ("🔍 گەڕان", self.search_files)
        ]
        
        for text, command in buttons:
            ttk.Button(toolbar, text=text, command=command).pack(side="left", padx=5)
        
        # لیستی فایلەکان
        list_frame = ttk.Frame(self.content_area)
        list_frame.pack(pady=20, padx=20, fill="both", expand=True)
        
        # Treeview بۆ نیشاندانی فایلەکان
        columns = ("ناو", "جۆر", "شوێن", "قەبارە")
        self.tree = ttk.Treeview(list_frame, columns=columns, show="headings")
        
        for col in columns:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=150)
        
        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        
        # پڕکردنەوەی فایلەکان
        self.refresh_file_list()
    
    def create_new_folder(self):
        dialog = tk.Toplevel(self.root)
        dialog.title("فۆڵدەری نوێ")
        dialog.geometry("300x200")
        
        tk.Label(dialog, text="ناوی فۆڵدەر:").pack(pady=20)
        name_entry = ttk.Entry(dialog, width=30)
        name_entry.pack(pady=10)
        
        def create():
            name = name_entry.get()
            if name:
                success, msg = self.file_manager.create_folder(".", name)
                messagebox.showinfo("ئەنجام", msg)
                if success:
                    self.refresh_file_list()
                    dialog.destroy()
        
        ttk.Button(dialog, text="دروستکردن", command=create).pack(pady=20)
    
    def upload_file(self):
        file_path = filedialog.askopenfilename()
        if file_path:
            file_name = os.path.basename(file_path)
            success, msg = self.file_manager.upload_file(".", file_path)
            messagebox.showinfo("ئەنجام", msg)
            if success:
                self.refresh_file_list()
    
    def delete_selected(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("هەڵە", "هیچ شتێک هەڵنەبژاردووە!")
            return
        
        if messagebox.askyesno("دڵنیایی", "دڵنیایی لە سڕینەوە؟"):
            for item in selected:
                path = self.tree.item(item)["values"][2]
                success, msg = self.file_manager.delete_item(path)
                if success:
                    self.tree.delete(item)
    
    def refresh_file_list(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        files = self.file_manager.list_files(".")
        for file_info in files:
            self.tree.insert("", "end", values=file_info)
    
    def show_user_manager(self):
        self.clear_content_area()
        
        tk.Label(self.content_area,
                text="👥 بەڕێوەبردنی یوزەرەکان",
                font=("Arial", 20, "bold"),
                fg=self.colors["dark"],
                bg=self.colors["light"]).pack(pady=20)
        
        # لیستی یوزەرەکان
        listbox = tk.Listbox(self.content_area, font=("Arial", 12), height=15)
        listbox.pack(pady=20, padx=20, fill="both", expand=True)
        
        for username, data in self.login_system.users.items():
            role = data["role"]
            listbox.insert("end", f"{username} - {role}")
        
        # بارتۆڵی ئامرازەکان
        toolbar = ttk.Frame(self.content_area)
        toolbar.pack(pady=10)
        
        ttk.Button(toolbar, text="سڕینەوە", command=lambda: self.delete_user(listbox)).pack(side="left", padx=5)
        ttk.Button(toolbar, text="گۆڕینی ڕۆڵ", command=lambda: self.change_role(listbox)).pack(side="left", padx=5)
    
    def delete_user(self, listbox):
        selection = listbox.curselection()
        if not selection:
            return
        
        username = listbox.get(selection[0]).split(" - ")[0]
        if username == "admin":
            messagebox.showerror("هەڵە", "ناتوانیت ئەدمین سڕیبکەیتەوە!")
            return
        
        if messagebox.askyesno("دڵنیایی", f"دڵنیایی لە سڕینەوەی {username}؟"):
            del self.login_system.users[username]
            self.login_system.save_users()
            listbox.delete(selection[0])
    
    def show_advanced_tools(self):
        self.clear_content_area()
        
        tk.Label(self.content_area,
                text="🛠️ ئامرازە پێشکەوتووەکان",
                font=("Arial", 20, "bold"),
                fg=self.colors["dark"],
                bg=self.colors["light"]).pack(pady=20)
        
        # ئامرازە جیاوازەکان
        tools_frame = ttk.Frame(self.content_area)
        tools_frame.pack(pady=20, padx=20)
        
        tools = [
            ("🔄 هاوکێشەی سیستەم", self.system_info),
            ("🧹 پاککردنەوەی کاڵا", self.cleanup),
            ("📊 تێڕوانینی داتا", self.data_insights),
            ("🔐 تاقیکردنەوەی پاراستن", self.security_test),
            ("⚡ خێراکردن", self.optimize_system)
        ]
        
        for i, (text, command) in enumerate(tools):
            btn = tk.Button(tools_frame,
                          text=text,
                          font=("Arial", 12, "bold"),
                          bg=self.colors["secondary"],
                          fg="white",
                          padx=20,
                          pady=15,
                          command=command)
            btn.grid(row=i//2, column=i%2, padx=10, pady=10, sticky="ew")
    
    def system_info(self):
        info = f"""
        === هاوکێشەی سیستەم ===
        
        یوزەر: {self.current_username}
        ڕۆڵ: {self.current_user['role']}
        
        کۆی یوزەر: {len(self.login_system.users)}
        فۆڵدەرەکان: {self.count_folders()}
        فایلەکان: {self.count_files()}
        
        کات: {datetime.datetime.now()}
        """
        
        messagebox.showinfo("هاوکێشەی سیستەم", info)
    
    def cleanup(self):
        # کۆدی پاککردنەوەی نموونەیی
        import tempfile
        tempfile.tempdir = None
        
        messagebox.showinfo("پاککردنەوە", "کاڵاکان پاککرانەوە!")
    
    def count_folders(self):
        count = 0
        for root, dirs, files in os.walk("."):
            count += len(dirs)
        return count
    
    def count_files(self):
        count = 0
        for root, dirs, files in os.walk("."):
            count += len(files)
        return count
    
    def show_settings(self):
        self.clear_content_area()
        tk.Label(self.content_area, text="⚙️ ڕێکخستنەکان").pack(pady=20)
    
    def show_reports(self):
        self.clear_content_area()
        tk.Label(self.content_area, text="📈 راپۆرتەکان").pack(pady=20)
    
    def show_permissions(self):
        self.clear_content_area()
        tk.Label(self.content_area, text="🔒 سیستەمی دەسەلات").pack(pady=20)
    
    def show_user_panel(self):
        self.clear_window()
        tk.Label(self.root, text="بەخێربێت بەکارهێنەر!").pack(pady=50)
    
    def download_file(self):
        messagebox.showinfo("زانیاری", "فایل دابەزێنرا!")
    
    def search_files(self):
        messagebox.showinfo("زانیاری", "گەڕان ئەنجامدرا!")
    
    def optimize_system(self):
        messagebox.showinfo("سەرکەوتوو", "سیستەم خێراکرا!")
    
    def data_insights(self):
        messagebox.showinfo("تێڕوانین", "تێڕوانینی داتا نمایشکرا!")
    
    def security_test(self):
        messagebox.showinfo("تاقیکردنەوە", "تاقیکردنەوەی پاراستن ئەنجامدرا!")
    
    def clear_content_area(self):
        for widget in self.content_area.winfo_children():
            widget.destroy()
    
    def clear_window(self):
        for widget in self.root.winfo_children():
            widget.destroy()
    
    def logout(self):
        self.current_user = None
        self.show_login_screen()

# ============ بەردەستکردنی ئەپەکە ============
if __name__ == "__main__":
    app = ModernApp()
    
    # بۆ داخستنی ئەپەکە بە ڕێکوپێکی
    def on_closing():
        if messagebox.askokcancel("چوونەدەرەوە", "دڵنیایی لە چوونەدەرەوە؟"):
            app.root.destroy()
    
    app.root.protocol("WM_DELETE_WINDOW", on_closing)
    app.root.mainloop()
